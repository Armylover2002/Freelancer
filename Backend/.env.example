NODE_ENV=development
PORT=5000

# MongoDB connection string
MONGODB_URI=

# Comma-separated list of allowed frontend origins (CORS allowlist)
CLIENT_URL=http://localhost:5173

# JWT auth (admin panel)
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_COOKIE_NAME=agency_admin_token

# First admin (owner) account, created/updated by `npm run seed`
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Cloudinary (media storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email notifications (optional - enquiry notifications are skipped gracefully if unset)
EMAIL_PROVIDER=smtp
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_API_KEY=
ADMIN_NOTIFICATION_EMAIL=

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
